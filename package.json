{
  "name": "better-github-workflows",
  "displayName": "Better Github Workflows",
  "version": "0.3.12",
  "description": "Better Github Workflows",
  "author": "revdev <mail@revdev.me>",
  "scripts": {
    "dev": "plasmo dev",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "package": "plasmo package",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:watch:coverage": "vitest watch --coverage",
    "lint": "yarn biome check"
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "axios": "1.20.0",
    "dotenv": "18.0.9",
    "framer-motion": "14.6.0",
    "mobx": "7.1.1",
    "mobx-react": "10.0.2",
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "manifest": {
    "host_permissions": [
      "https://github.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{312afe32-242c-46f1-9149-48867c59652d}"
      }
    }
  }
}
